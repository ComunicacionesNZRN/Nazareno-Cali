    <main class="inner-page media-library-page">
      <section class="media-page-hero" aria-labelledby="messages-title">
        <img class="media-page-hero-image" src="Media/01.jpg" alt="Comunidad de Iglesia del Nazareno Cali reunida en una celebración" fetchpriority="high" />
        <div class="media-page-hero-shade" aria-hidden="true"></div>
        <div class="media-page-hero-copy">
          <p class="eyebrow">06 · Nazareno en línea</p>
          <h1 id="messages-title">Una palabra<br />para tu <em>semana.</em></h1>
          <p class="inner-lead">
            Mira la transmisión y vuelve a escuchar mensajes que te acompañen
            donde estés.
          </p>
        </div>
      </section>
      <section class="media-library" data-media-library aria-labelledby="media-library-title">
        <div class="media-library-switcher" role="tablist" aria-label="Tipo de contenido">
          <button id="sermons-tab" class="media-library-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="sermons-panel" data-library-tab="sermones">Prédicas</button>
          <button id="podcasts-tab" class="media-library-tab" type="button" role="tab" aria-selected="false" aria-controls="podcasts-panel" data-library-tab="podcasts">Podcasts</button>
        </div>

        <section id="sermons-panel" class="media-library-panel" role="tabpanel" aria-labelledby="sermons-tab" data-library-panel="sermones">
          <div class="media-library-heading">
            <h2 id="media-library-title">Últimos sermones</h2>
            <div class="media-library-tools">
              <div class="media-filter" role="tablist" aria-label="Filtrar prédicas">
                <button class="media-filter-tab" type="button" role="tab" aria-selected="false" data-sermon-filter="past">Sermones pasados</button>
                <button class="media-filter-tab is-active" type="button" role="tab" aria-selected="true" data-sermon-filter="latest">Último sermón / En vivo</button>
              </div>
              <label class="media-sort-control">
                <span>Ordenar histórico</span>
                <select data-sermon-order aria-label="Ordenar sermones pasados">
                  <option value="asc" selected>Antiguos a recientes</option>
                  <option value="desc">Recientes a antiguos</option>
                </select>
              </label>
            </div>
          </div>
          <p class="media-library-state" data-sermon-state role="status">Cargando prédicas...</p>
          <div class="media-card-grid" data-sermon-grid aria-live="polite"></div>
        </section>

        <section id="podcasts-panel" class="media-library-panel" role="tabpanel" aria-labelledby="podcasts-tab" data-library-panel="podcasts" hidden>
          <div class="media-library-heading">
            <h2>Podcasts</h2>
            <p>Conversaciones y enseñanzas para escuchar donde estés.</p>
          </div>
          <p class="media-library-state" data-podcast-state role="status">Cargando podcasts...</p>
          <div class="media-card-grid" data-podcast-grid aria-live="polite"></div>
        </section>
      </section>

      <dialog class="media-player-dialog" data-media-dialog aria-labelledby="media-dialog-title">
        <div class="media-dialog-bar">
          <h2 id="media-dialog-title">Reproducción</h2>
          <button class="media-dialog-close" type="button" aria-label="Cerrar reproductor" data-media-dialog-close>
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          </button>
        </div>
        <div class="media-dialog-frame">
          <iframe title="Reproductor de YouTube" data-media-iframe allow="autoplay; encrypted-media; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
      </dialog>

